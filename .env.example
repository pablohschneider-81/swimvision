# F4F Assistant — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Proveedor de WhatsApp ──────────────────────────────────
WHATSAPP_PROVIDER=twilio

# ── Twilio ──────────────────────────────────────────────────
# Configurar en: https://twilio.com (Console → Account SID / Auth Token)
# Messaging → Try it Out → Send a WhatsApp message → activar sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Meta Cloud API (si más adelante migras WHATSAPP_PROVIDER=meta) ──
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=f4f-assistant-verify

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
